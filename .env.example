# Copy to backend/.env if you want to override defaults.
# Native dev uses SQLite. PostgreSQL is for Docker Compose and CI.

APP_ENV=demo
HOST=127.0.0.1
PORT=8103
ALLOW_NETWORK_BIND=false
RESET_DEMO=false

# Default when unset: backend/data/workforce.db (absolute path chosen by the app).
# DATABASE_URL=sqlite:///./data/workforce.db

# Compose / CI only:
# DATABASE_URL=postgresql+psycopg://wfo:wfo@127.0.0.1:5403/wfo

SOLVER_NUM_WORKERS=4
SOLVER_DETERMINISTIC_TIME_SECONDS=10
SOLVER_FAST_TIME_SECONDS=10
STALE_RUN_SECONDS=120
CORS_ORIGINS=http://127.0.0.1:5103,http://localhost:5103
